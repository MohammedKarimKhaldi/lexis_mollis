<section class="graph-shell" aria-label="Explorateur du graphe">
  <div class="graph-topbar">
    <label class="graph-search">
      <span class="search-icon" aria-hidden="true">⌕</span>
      <span class="visually-hidden">Rechercher dans le graphe</span>
      <input id="graph-filter" type="search" placeholder="Rechercher un traité, un pays, un thème…" />
    </label>
    <div class="graph-meta" aria-live="polite">
      <span id="graph-count">—</span>
      <span id="semantica-status" class="semantica-status" hidden>Semantica actif</span>
    </div>
    <button id="graph-reset" class="graph-text-button" type="button">Tout afficher</button>
  </div>

  <div class="graph-workspace">
    <div class="graph-map">
      <div id="sigma-container" aria-label="Carte interactive des communautés documentaires"></div>
      <div class="map-caption">
        <strong>Vue par communautés</strong>
        <span>Glisser pour déplacer · molette pour zoomer</span>
      </div>
      <div class="zoom-controls" aria-label="Contrôles du zoom">
        <button id="graph-zoom-in" type="button" aria-label="Zoomer">+</button>
        <button id="graph-zoom-out" type="button" aria-label="Dézoomer">−</button>
        <button id="graph-zoom-fit" type="button" aria-label="Recentrer">⌂</button>
      </div>
      <div id="graph-loading" class="graph-overlay">
        <div class="graph-spinner" aria-hidden="true"></div>
        <p id="graph-loading-text">Préparation des communautés…</p>
      </div>
      <div id="graph-error" class="graph-overlay graph-error" hidden>
        <p class="graph-error-title">Le graphe n'a pas pu s'afficher</p>
        <p id="graph-error-detail" class="muted"></p>
        <div class="graph-error-actions">
          <button id="graph-retry" class="button secondary" type="button">Réessayer</button>
          <a class="button secondary" href="/data/graph.sigma.json">Données JSON</a>
        </div>
      </div>
    </div>

    <aside class="graph-panel" aria-live="polite">
      <div id="community-overview">
        <div class="panel-heading">
          <div>
            <span class="panel-kicker">Explorer</span>
            <h2>Communautés</h2>
          </div>
          <button id="community-clear" class="graph-text-button" type="button" hidden>Effacer</button>
        </div>
        <p class="panel-intro">Les couleurs regroupent les documents qui partagent les liens les plus forts.</p>
        <div id="community-list" class="community-list"></div>
      </div>

      <article id="graph-detail" class="node-detail" hidden>
        <button id="detail-back" class="detail-back" type="button">← Communautés</button>
        <div id="node-detail-content"></div>
      </article>
    </aside>
  </div>

  <details class="graph-options">
    <summary>Affiner la vue</summary>
    <div class="graph-options-content">
      <label>
        <span>Similarité minimale <strong id="weight-value">0.00</strong></span>
        <input id="graph-weight" type="range" min="0" max="1" step="0.01" value="0" />
      </label>
      <fieldset>
        <legend>Types de liens</legend>
        <div id="edge-type-toggles" class="toggle-list"></div>
      </fieldset>
    </div>
  </details>

  <noscript>
    <p class="muted">Le graphe interactif nécessite JavaScript. Export brut : <a href="/data/graph.sigma.json">graph.sigma.json</a>.</p>
  </noscript>
</section>

<script>
  import Graph from "graphology";
  import Sigma from "sigma";
  import type { Settings } from "sigma/settings";

  interface CommunityRow {
    id: string;
    label: string;
    count: number;
  }

  interface CommunityPayload {
    method?: string;
    communities?: CommunityRow[];
    membership?: Record<string, string>;
  }

  const container = document.querySelector<HTMLElement>("#sigma-container");
  const loadingEl = document.querySelector<HTMLElement>("#graph-loading");
  const loadingText = document.querySelector<HTMLElement>("#graph-loading-text");
  const errorEl = document.querySelector<HTMLElement>("#graph-error");
  const errorDetail = document.querySelector<HTMLElement>("#graph-error-detail");
  const retryButton = document.querySelector<HTMLButtonElement>("#graph-retry");
  const overview = document.querySelector<HTMLElement>("#community-overview");
  const detail = document.querySelector<HTMLElement>("#graph-detail");
  const detailContent = document.querySelector<HTMLElement>("#node-detail-content");
  const detailBack = document.querySelector<HTMLButtonElement>("#detail-back");
  const communityList = document.querySelector<HTMLElement>("#community-list");
  const communityClear = document.querySelector<HTMLButtonElement>("#community-clear");
  const count = document.querySelector<HTMLElement>("#graph-count");
  const semanticaStatus = document.querySelector<HTMLElement>("#semantica-status");
  const filter = document.querySelector<HTMLInputElement>("#graph-filter");
  const weightSlider = document.querySelector<HTMLInputElement>("#graph-weight");
  const weightValue = document.querySelector<HTMLElement>("#weight-value");
  const resetButton = document.querySelector<HTMLButtonElement>("#graph-reset");
  const edgeTypeToggles = document.querySelector<HTMLElement>("#edge-type-toggles");
  const zoomIn = document.querySelector<HTMLButtonElement>("#graph-zoom-in");
  const zoomOut = document.querySelector<HTMLButtonElement>("#graph-zoom-out");
  const zoomFit = document.querySelector<HTMLButtonElement>("#graph-zoom-fit");

  const communityColors = [
    "#167982",
    "#536eae",
    "#c27a22",
    "#765ca7",
    "#ca6258",
    "#398761",
    "#3f8fae",
    "#8b98a5"
  ];

  const communityCenters = [
    { x: 0.34, y: 0.40 },
    { x: 0.69, y: 0.38 },
    { x: 0.49, y: 0.72 },
    { x: 0.17, y: 0.72 },
    { x: 0.82, y: 0.68 },
    { x: 0.18, y: 0.17 },
    { x: 0.78, y: 0.16 },
    { x: 0.50, y: 0.08 }
  ];

  const edgeTypeLabels: Record<string, string> = {
    similar_to: "Documents proches",
    translation: "Traductions",
    same_instrument_as: "Même instrument",
    about_topic: "Thème commun",
    dated: "Même période",
    issued_by: "Même émetteur",
    party_to: "Même partie",
    signed_at: "Même lieu"
  };

  function escapeHtml(value: unknown): string {
    return String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }

  function showError(err: unknown) {
    console.error("Graph view failed to initialize", err);
    if (loadingEl) loadingEl.hidden = true;
    if (errorEl) errorEl.hidden = false;
    if (errorDetail) {
      const message = err instanceof Error ? err.message : String(err);
      errorDetail.textContent = message || "Erreur inconnue.";
    }
  }

  function drawPillLabel(
    context: CanvasRenderingContext2D,
    data: { x: number; y: number; size: number; label?: string | null; color?: string },
    settings: Settings
  ) {
    if (!data.label) return;
    const size = settings.labelSize;
    context.font = `${settings.labelWeight} ${size}px ${settings.labelFont}`;
    const clippedLabel = data.label.length > 46 ? `${data.label.slice(0, 45)}…` : data.label;
    const width = context.measureText(clippedLabel).width;
    const paddingX = 8;
    const paddingY = 4;
    const x = data.x + data.size + 5;
    const rectY = data.y - size / 2 - paddingY;
    const rectH = size + paddingY * 2;
    const rectW = width + paddingX * 2 + 8;
    const radius = rectH / 2;

    context.beginPath();
    context.roundRect(x, rectY, rectW, rectH, radius);
    context.fillStyle = "rgba(255, 254, 250, 0.96)";
    context.fill();
    context.strokeStyle = "rgba(23, 33, 43, 0.12)";
    context.lineWidth = 1;
    context.stroke();

    context.beginPath();
    context.arc(x + 9, rectY + rectH / 2, 2.5, 0, Math.PI * 2);
    context.fillStyle = data.color || "#167982";
    context.fill();
    context.fillStyle = "#17212b";
    context.textBaseline = "middle";
    context.fillText(clippedLabel, x + paddingX + 8, rectY + rectH / 2);
  }

  function deterministicOffset(value: string): number {
    let hash = 0;
    for (let index = 0; index < value.length; index += 1) hash = (hash * 31 + value.charCodeAt(index)) | 0;
    return ((hash >>> 0) % 1000) / 1000 - 0.5;
  }

  async function init() {
    if (!container) return;

    const canvasProbe = document.createElement("canvas");
    if (!(canvasProbe.getContext("webgl2") || canvasProbe.getContext("webgl"))) {
      throw new Error("WebGL est nécessaire pour afficher le graphe. Vérifiez l'accélération matérielle du navigateur.");
    }

    const controller = new AbortController();
    const timeout = window.setTimeout(() => controller.abort(), 30000);
    let graphResponse: Response;
    let communitiesResponse: Response;
    try {
      [graphResponse, communitiesResponse] = await Promise.all([
        fetch("/data/graph.sigma.json", { signal: controller.signal }),
        fetch("/data/graph.communities.json", { signal: controller.signal })
      ]);
    } catch {
      throw new Error("Le téléchargement du graphe a échoué ou a expiré.");
    } finally {
      window.clearTimeout(timeout);
    }
    if (!graphResponse.ok) throw new Error(`Le serveur a répondu ${graphResponse.status} pour le graphe.`);

    const payload = await graphResponse.json();
    const communityPayload: CommunityPayload = communitiesResponse.ok ? await communitiesResponse.json() : {};
    if (loadingText) loadingText.textContent = "Organisation des communautés…";

    const rawNodes: any[] = payload.nodes || [];
    if (!rawNodes.length) throw new Error("Les données du graphe sont vides.");

    const sourceMembership = communityPayload.membership || {};
    const sourceLabels = new Map((communityPayload.communities || []).map((row) => [row.id, row.label]));
    const sourceCounts = new Map<string, number>();
    for (const node of rawNodes) {
      const sourceId = sourceMembership[node.id] || "community_other";
      sourceCounts.set(sourceId, (sourceCounts.get(sourceId) || 0) + 1);
    }
    const primaryCommunityIds = [...sourceCounts]
      .sort((left, right) => right[1] - left[1])
      .slice(0, 7)
      .map(([id]) => id);
    const primarySet = new Set(primaryCommunityIds);
    const visualMembership = new Map<string, string>();
    const visualCounts = new Map<string, number>();
    for (const node of rawNodes) {
      const sourceId = sourceMembership[node.id] || "community_other";
      const visualId = primarySet.has(sourceId) ? sourceId : "community_other";
      visualMembership.set(node.id, visualId);
      visualCounts.set(visualId, (visualCounts.get(visualId) || 0) + 1);
    }

    const orderedCommunityIds = [
      ...primaryCommunityIds,
      ...(visualCounts.has("community_other") ? ["community_other"] : [])
    ];
    const communities: CommunityRow[] = orderedCommunityIds.map((id) => ({
      id,
      label: id === "community_other" ? "Autres communautés" : sourceLabels.get(id) || "Documents liés",
      count: visualCounts.get(id) || 0
    }));
    const communityById = new Map(communities.map((row, index) => [row.id, { ...row, color: communityColors[index] }]));

    const rawByCommunity = new Map<string, any[]>();
    for (const node of rawNodes) {
      const communityId = visualMembership.get(node.id) || "community_other";
      const rows = rawByCommunity.get(communityId) || [];
      rows.push(node);
      rawByCommunity.set(communityId, rows);
    }

    const positions = new Map<string, { x: number; y: number }>();
    const maxCommunitySize = Math.max(...communities.map((row) => row.count), 1);
    communities.forEach((community, index) => {
      const rows = rawByCommunity.get(community.id) || [];
      const xs = rows.map((node) => Number(node.x)).filter(Number.isFinite);
      const ys = rows.map((node) => Number(node.y)).filter(Number.isFinite);
      const xMin = xs.length ? Math.min(...xs) : 0;
      const xMax = xs.length ? Math.max(...xs) : 1;
      const yMin = ys.length ? Math.min(...ys) : 0;
      const yMax = ys.length ? Math.max(...ys) : 1;
      const span = Math.max(xMax - xMin, yMax - yMin, 0.01);
      const center = communityCenters[index] || communityCenters[communityCenters.length - 1];
      const radius = 0.07 + 0.105 * Math.sqrt(community.count / maxCommunitySize);
      for (const node of rows) {
        const rawX = Number.isFinite(Number(node.x)) ? Number(node.x) : xMin + span / 2;
        const rawY = Number.isFinite(Number(node.y)) ? Number(node.y) : yMin + span / 2;
        const jitter = deterministicOffset(String(node.id)) * 0.006;
        positions.set(node.id, {
          x: center.x + ((rawX - (xMin + xMax) / 2) / span) * radius * 2 + jitter,
          y: center.y + ((rawY - (yMin + yMax) / 2) / span) * radius * 2 - jitter
        });
      }
    });

    const graph = new Graph();
    const rawSizeMax = Math.max(1, ...rawNodes.map((node) => Number(node.size) || 0));
    const scaleSize = (value: number) => 2.3 + 6.2 * Math.sqrt(Math.max(0, value) / rawSizeMax);

    for (const node of rawNodes) {
      const communityId = visualMembership.get(node.id) || "community_other";
      const community = communityById.get(communityId);
      const position = positions.get(node.id) || { x: Math.random(), y: Math.random() };
      const baseSize = scaleSize(Number(node.size) || 0);
      graph.addNode(node.id, {
        label: node.label || node.id,
        x: position.x,
        y: position.y,
        size: baseSize,
        baseSize,
        baseColor: community?.color || communityColors.at(-1),
        color: community?.color || communityColors.at(-1),
        communityId,
        communityLabel: community?.label || "Autres communautés",
        entityType: node.type || "Document",
        document_id:
          (node.type || "Document") === "Document" ? node.document_id || node.id.replace(/^doc:/, "") : null
      });
    }

    for (const edge of payload.edges || []) {
      if (!graph.hasNode(edge.source) || !graph.hasNode(edge.target)) continue;
      graph.mergeEdge(edge.source, edge.target, {
        label: edge.type || "link",
        edgeType: edge.type || "link",
        weight: Number(edge.weight || 0),
        size: Math.max(0.55, Math.min(2.4, Number(edge.weight || 1) * 1.7)),
        baseColor: edge.provisional ? "rgba(194, 122, 34, 0.35)" : "rgba(23, 33, 43, 0.14)",
        color: edge.provisional ? "rgba(194, 122, 34, 0.35)" : "rgba(23, 33, 43, 0.14)"
      });
    }

    const renderer = new Sigma(graph, container, {
      renderEdgeLabels: false,
      allowInvalidContainer: true,
      zIndex: true,
      hideEdgesOnMove: true,
      hideLabelsOnMove: true,
      labelRenderedSizeThreshold: 8.2,
      labelDensity: 0.65,
      labelGridCellSize: 130,
      stagePadding: 42,
      minCameraRatio: 0.35,
      maxCameraRatio: 4,
      labelFont: "Inter, ui-sans-serif, system-ui, sans-serif",
      labelSize: 12,
      labelWeight: "600",
      labelColor: { color: "#17212b" },
      defaultDrawNodeLabel: drawPillLabel,
      defaultDrawNodeHover: drawPillLabel
    });

    if (loadingEl) loadingEl.hidden = true;
    const camera = renderer.getCamera();
    camera.setState({ ratio: 1.22 });
    camera.animate({ ratio: 1 }, { duration: 650, easing: "quadraticOut" });

    const semanticaBaseUrl =
      location.hostname === "127.0.0.1" || location.hostname === "localhost"
        ? `http://${location.hostname}:8000`
        : null;
    let semanticaAvailable = false;
    let semanticaMatches: Set<string> | null = null;
    let semanticaSearchSequence = 0;
    let semanticaDetailSequence = 0;

    if (semanticaBaseUrl) {
      try {
        const healthController = new AbortController();
        const healthTimeout = window.setTimeout(() => healthController.abort(), 1500);
        const response = await fetch(`${semanticaBaseUrl}/api/health`, { signal: healthController.signal });
        window.clearTimeout(healthTimeout);
        semanticaAvailable = response.ok;
        if (semanticaStatus) semanticaStatus.hidden = !semanticaAvailable;
      } catch {
        semanticaAvailable = false;
      }
    }

    const activeEdgeTypes = new Set(graph.edges().map((id) => graph.getEdgeAttribute(id, "edgeType")));
    const disabledEdgeTypes = new Set<string>();
    for (const type of activeEdgeTypes) {
      const wrapper = document.createElement("label");
      wrapper.className = "toggle-chip";
      const checkbox = document.createElement("input");
      checkbox.type = "checkbox";
      checkbox.checked = true;
      wrapper.append(checkbox, document.createTextNode(edgeTypeLabels[type] || type));
      edgeTypeToggles?.appendChild(wrapper);
      checkbox.addEventListener("change", () => {
        if (checkbox.checked) disabledEdgeTypes.delete(type);
        else disabledEdgeTypes.add(type);
        applyFilters();
      });
    }

    let focusNode: string | null = null;
    let hoverNode: string | null = null;
    let activeCommunity: string | null = null;
    let neighborSet = new Set<string>();
    let neighborEdges = new Set<string>();
    let hoverEdges = new Set<string>();

    function edgeVisible(edgeId: string): boolean {
      const attrs = graph.getEdgeAttributes(edgeId);
      return !disabledEdgeTypes.has(attrs.edgeType) && attrs.weight >= Number(weightSlider?.value || 0);
    }

    function matchesSearch(node: string): boolean {
      const query = (filter?.value || "").trim().toLocaleLowerCase("fr");
      if (!query) return true;
      const label = String(graph.getNodeAttribute(node, "label") || "").toLocaleLowerCase("fr");
      return label.includes(query) || Boolean(semanticaMatches?.has(node));
    }

    function updateCount() {
      const query = (filter?.value || "").trim();
      if (query) {
        const matches = graph.nodes().filter(matchesSearch).length;
        if (count) count.textContent = `${matches} résultat${matches > 1 ? "s" : ""}`;
        return;
      }
      if (activeCommunity) {
        const selected = communityById.get(activeCommunity);
        if (count) count.textContent = `${selected?.count || 0} documents`;
        return;
      }
      if (count) count.textContent = `${graph.order.toLocaleString("fr-FR")} documents · ${graph.size.toLocaleString("fr-FR")} liens`;
    }

    function applyFilters() {
      const hasQuery = Boolean((filter?.value || "").trim());
      const edgeReducer = (edge: string, data: any) => {
        if (!edgeVisible(edge)) return { ...data, hidden: true };
        if (focusNode) {
          return neighborEdges.has(edge)
            ? { ...data, color: "rgba(22, 121, 130, 0.62)", size: Math.max(data.size, 1.2), zIndex: 2 }
            : { ...data, hidden: true };
        }
        if (hoverNode) {
          return hoverEdges.has(edge)
            ? { ...data, color: "rgba(23, 33, 43, 0.28)", zIndex: 1 }
          : { ...data, hidden: true };
        }
        return { ...data, hidden: true };
      };

      const nodeReducer = (node: string, data: any) => {
        let result = { ...data, color: data.baseColor, size: data.baseSize };
        if (hasQuery) {
          if (!matchesSearch(node)) return { ...result, color: "#d7dedf", size: 0.9, label: "" };
          result = { ...result, size: Math.max(data.baseSize, 8.5), zIndex: 3, forceLabel: true };
        }
        if (activeCommunity && data.communityId !== activeCommunity) {
          return { ...result, color: "#d7dedf", size: 0.85, label: "" };
        }
        if (activeCommunity && data.communityId === activeCommunity) {
          result = { ...result, size: Math.max(data.baseSize, 4.2), zIndex: 2 };
        }
        if (focusNode) {
          if (node === focusNode) return { ...result, size: 12, zIndex: 5, forceLabel: true };
          if (neighborSet.has(node)) return { ...result, size: Math.max(data.baseSize, 6.5), zIndex: 3, forceLabel: true };
          return { ...result, color: "#dce2e2", size: 0.8, label: "" };
        }
        if (node === hoverNode) return { ...result, size: Math.max(data.baseSize, 9.5), zIndex: 4, forceLabel: true };
        return result;
      };

      updateCount();
      renderer.setSettings({ edgeReducer, nodeReducer });
    }

    function showOverview() {
      if (overview) overview.hidden = false;
      if (detail) detail.hidden = true;
    }

    function showDetail() {
      if (overview) overview.hidden = true;
      if (detail) detail.hidden = false;
    }

    function renderCommunityList() {
      if (!communityList) return;
      communityList.replaceChildren();
      for (const community of communities) {
        const row = communityById.get(community.id);
        const button = document.createElement("button");
        button.type = "button";
        button.className = "community-button";
        button.setAttribute("aria-pressed", String(activeCommunity === community.id));
        button.innerHTML = `
          <span class="community-dot" style="--community-color:${row?.color || communityColors.at(-1)}"></span>
          <span class="community-label">${escapeHtml(community.label)}</span>
          <span class="community-count">${community.count.toLocaleString("fr-FR")}</span>
        `;
        button.addEventListener("click", () => {
          focusNode = null;
          neighborSet = new Set();
          neighborEdges = new Set();
          activeCommunity = activeCommunity === community.id ? null : community.id;
          if (communityClear) communityClear.hidden = !activeCommunity;
          renderCommunityList();
          applyFilters();
          if (activeCommunity) {
            const center = communityCenters[communities.findIndex((item) => item.id === activeCommunity)];
            if (center) void camera.animate({ x: center.x, y: center.y, ratio: 0.72 }, { duration: 450, easing: "quadraticInOut" });
          } else {
            void camera.animatedReset({ duration: 450 });
          }
        });
        communityList.appendChild(button);
      }
    }

    async function searchWithSemantica(query: string) {
      const sequence = ++semanticaSearchSequence;
      if (!semanticaAvailable || !semanticaBaseUrl || query.length < 2) {
        semanticaMatches = null;
        applyFilters();
        return;
      }
      try {
        const response = await fetch(`${semanticaBaseUrl}/api/graph/search`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ query, limit: 50, rank_by: "relevance" })
        });
        if (!response.ok) return;
        const results = await response.json();
        if (sequence !== semanticaSearchSequence) return;
        semanticaMatches = new Set(
          (results.results || [])
            .map((result: any) => String(result.node?.id || ""))
            .filter((nodeId: string) => graph.hasNode(nodeId))
        );
        applyFilters();
      } catch {
        // The static graph remains usable if the optional Semantica API stops.
      }
    }

    async function appendSemanticaInsight(node: string) {
      const sequence = ++semanticaDetailSequence;
      if (!semanticaAvailable || !semanticaBaseUrl || !detailContent) return;
      try {
        const encodedNode = encodeURIComponent(node);
        const [neighborsResponse, provenanceResponse] = await Promise.all([
          fetch(`${semanticaBaseUrl}/api/graph/node/${encodedNode}/neighbors?depth=1`),
          fetch(`${semanticaBaseUrl}/api/provenance?node_id=${encodedNode}`)
        ]);
        if (!neighborsResponse.ok || !provenanceResponse.ok || sequence !== semanticaDetailSequence) return;
        const neighbors = await neighborsResponse.json();
        const provenance = await provenanceResponse.json();
        if (sequence !== semanticaDetailSequence) return;
        const provenanceCount = Array.isArray(provenance.nodes) ? provenance.nodes.length : 0;
        detailContent.insertAdjacentHTML(
          "beforeend",
          `<p class="semantica-insight"><strong>Semantica</strong><span>${Array.isArray(neighbors) ? neighbors.length : 0} relations analysées${
            provenanceCount ? ` · ${provenanceCount} traces de provenance` : ""
          }</span></p>`
        );
      } catch {
        // Semantica enriches the panel without blocking it.
      }
    }

    function describeNeighbors(node: string): string {
      const rows = graph
        .edges(node)
        .filter(edgeVisible)
        .map((edgeId) => {
          const other = graph.opposite(node, edgeId);
          const otherAttrs = graph.getNodeAttributes(other);
          const edgeAttrs = graph.getEdgeAttributes(edgeId);
          return { label: otherAttrs.label, type: edgeAttrs.edgeType, weight: edgeAttrs.weight, otherAttrs };
        })
        .sort((left, right) => right.weight - left.weight)
        .slice(0, 8);

      if (!rows.length) return '<p class="empty-links">Aucun lien visible avec les filtres actuels.</p>';
      return `<ol class="neighbor-list">${rows
        .map((row) => {
          const label = row.otherAttrs.document_id
            ? `<a href="/document/${encodeURIComponent(row.otherAttrs.document_id)}/">${escapeHtml(row.label)}</a>`
            : escapeHtml(row.label);
          return `<li>${label}<span>${escapeHtml(
            edgeTypeLabels[row.type] || row.type
          )} · ${Number(row.weight).toFixed(2)}</span></li>`;
        })
        .join("")}</ol>`;
    }

    renderer.on("clickNode", ({ node }) => {
      const attrs = graph.getNodeAttributes(node);
      focusNode = node;
      activeCommunity = null;
      if (communityClear) communityClear.hidden = true;
      neighborEdges = new Set(graph.edges(node));
      neighborSet = new Set(graph.neighbors(node));
      if (detailContent) {
        detailContent.innerHTML = `
          <span class="detail-community"><i style="--community-color:${escapeHtml(attrs.baseColor)}"></i>${escapeHtml(attrs.communityLabel)}</span>
          <h2>${escapeHtml(attrs.label)}</h2>
          ${
            attrs.document_id
              ? `<a class="detail-document-link" href="/document/${encodeURIComponent(attrs.document_id)}/">Ouvrir la fiche →</a>`
              : ""
          }
          <div class="neighbor-heading"><strong>Connexions directes</strong><span>${neighborSet.size}</span></div>
          ${describeNeighbors(node)}
        `;
      }
      showDetail();
      applyFilters();
      void appendSemanticaInsight(node);
    });

    renderer.on("clickStage", () => {
      semanticaDetailSequence += 1;
      focusNode = null;
      neighborSet = new Set();
      neighborEdges = new Set();
      showOverview();
      applyFilters();
    });

    renderer.on("enterNode", ({ node }) => {
      if (focusNode) return;
      hoverNode = node;
      hoverEdges = new Set(graph.edges(node));
      container.style.cursor = "pointer";
      applyFilters();
    });

    renderer.on("leaveNode", () => {
      if (focusNode) return;
      hoverNode = null;
      hoverEdges = new Set();
      container.style.cursor = "grab";
      applyFilters();
    });

    let searchTimer: number | undefined;
    filter?.addEventListener("input", () => {
      semanticaMatches = null;
      activeCommunity = null;
      if (communityClear) communityClear.hidden = true;
      renderCommunityList();
      applyFilters();
      window.clearTimeout(searchTimer);
      searchTimer = window.setTimeout(() => void searchWithSemantica((filter.value || "").trim()), 220);
    });

    weightSlider?.addEventListener("input", () => {
      if (weightValue) weightValue.textContent = Number(weightSlider.value).toFixed(2);
      applyFilters();
    });

    function resetView() {
      semanticaSearchSequence += 1;
      semanticaDetailSequence += 1;
      semanticaMatches = null;
      activeCommunity = null;
      focusNode = null;
      hoverNode = null;
      neighborSet = new Set();
      neighborEdges = new Set();
      hoverEdges = new Set();
      if (filter) filter.value = "";
      if (weightSlider) weightSlider.value = "0";
      if (weightValue) weightValue.textContent = "0.00";
      if (communityClear) communityClear.hidden = true;
      renderCommunityList();
      showOverview();
      applyFilters();
      void camera.animatedReset({ duration: 450 });
    }

    resetButton?.addEventListener("click", resetView);
    communityClear?.addEventListener("click", resetView);
    detailBack?.addEventListener("click", () => {
      focusNode = null;
      neighborSet = new Set();
      neighborEdges = new Set();
      showOverview();
      applyFilters();
    });
    zoomIn?.addEventListener("click", () => void camera.animatedZoom({ duration: 220 }));
    zoomOut?.addEventListener("click", () => void camera.animatedUnzoom({ duration: 220 }));
    zoomFit?.addEventListener("click", () => void camera.animatedReset({ duration: 350 }));

    renderCommunityList();
    showOverview();
    applyFilters();
  }

  retryButton?.addEventListener("click", () => location.reload());
  init().catch(showError);
</script>

